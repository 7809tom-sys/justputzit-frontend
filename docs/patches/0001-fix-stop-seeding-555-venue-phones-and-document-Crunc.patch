Subject: [PATCH 1/2] fix: stop seeding 555 venue phones and document Crunch
 partner cleanup

Set the two fictional venue phones to null and add hand-run SQL that clears 555 venue phones and marks the four seeded Crunch gyms as non-partners. Neither SQL file is executed.
---
 hand-run/null-555-venue-phones.sql     | 12 ++++++++
 hand-run/unset-crunch-gym-partners.sql | 23 +++++++++++++++
 seed-local-venues.mjs                  |  4 +--
 server/handRunSql.test.ts              | 39 ++++++++++++++++++++++++++
 4 files changed, 76 insertions(+), 2 deletions(-)
 create mode 100644 hand-run/null-555-venue-phones.sql
 create mode 100644 hand-run/unset-crunch-gym-partners.sql
 create mode 100644 server/handRunSql.test.ts

diff --git a/hand-run/null-555-venue-phones.sql b/hand-run/null-555-venue-phones.sql
new file mode 100644
index 0000000..023b77a
--- /dev/null
+++ b/hand-run/null-555-venue-phones.sql
@@ -0,0 +1,12 @@
+-- Hand-run only. Do not execute this from the migration runner, deploy, or CI.
+-- Venue records are stored in venue_partners. There is no table named venues.
+-- This clears fictional 555 exchange numbers already stored on those rows.
+-- Review the SELECT before the UPDATE, then run the UPDATE yourself.
+
+SELECT id, name, city, phone
+FROM venue_partners
+WHERE phone REGEXP '555[-. ]?[0-9]{4}';
+
+UPDATE venue_partners
+SET phone = NULL
+WHERE phone REGEXP '555[-. ]?[0-9]{4}';
diff --git a/hand-run/unset-crunch-gym-partners.sql b/hand-run/unset-crunch-gym-partners.sql
new file mode 100644
index 0000000..999a165
--- /dev/null
+++ b/hand-run/unset-crunch-gym-partners.sql
@@ -0,0 +1,23 @@
+-- Hand-run only. Do not execute this from the migration runner, deploy, or CI.
+-- The four seeded Crunch Fitness gyms are not Just Putzit partners.
+-- Review the SELECT before the UPDATE, then run the UPDATE yourself.
+
+SELECT id, name, city, is_partner, partner_tier
+FROM gyms
+WHERE id IN (30001, 30002, 30003, 30004)
+   OR name IN (
+     'Crunch Fitness - Waukesha',
+     'Crunch Fitness - Brookfield',
+     'Crunch Fitness - West Allis',
+     'Crunch Fitness - Wauwatosa'
+   );
+
+UPDATE gyms
+SET is_partner = 0
+WHERE id IN (30001, 30002, 30003, 30004)
+  AND name IN (
+    'Crunch Fitness - Waukesha',
+    'Crunch Fitness - Brookfield',
+    'Crunch Fitness - West Allis',
+    'Crunch Fitness - Wauwatosa'
+  );
