diff --git a/server/handRunSql.test.ts b/server/handRunSql.test.ts
new file mode 100644
index 0000000..0048149
--- /dev/null
+++ b/server/handRunSql.test.ts
@@ -0,0 +1,39 @@
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { describe, expect, it } from "vitest";
+
+describe("hand-run data corrections", () => {
+  it("stops seeding fictional 555 venue phones", () => {
+    const seed = readFileSync(resolve(__dirname, "../seed-local-venues.mjs"), "utf8");
+    expect(seed).not.toContain("555-0199");
+    expect(seed).not.toContain("555-0142");
+    expect(seed).toContain('name: "Escape the Room Waukesha"');
+    expect(seed).toContain('name: "Cafe Corazón — Waukesha"');
+    expect(seed).toMatch(/Escape the Room Waukesha[\s\S]*phone: null/);
+    expect(seed).toMatch(/Cafe Corazón — Waukesha[\s\S]*phone: null/);
+  });
+
+  it("keeps the 555-phone and Crunch partner corrections out of automatic migrations", () => {
+    const phones = readFileSync(resolve(__dirname, "../hand-run/null-555-venue-phones.sql"), "utf8");
+    const crunch = readFileSync(resolve(__dirname, "../hand-run/unset-crunch-gym-partners.sql"), "utf8");
+    const migrate = readFileSync(resolve(__dirname, "../migration/migrate.ts"), "utf8");
+
+    expect(phones).toContain("Hand-run only");
+    expect(phones).toContain("UPDATE venue_partners");
+    expect(phones).toContain("SET phone = NULL");
+    expect(phones).toContain("555[-. ]?[0-9]{4}");
+    expect(phones.toUpperCase()).not.toContain("DROP ");
+
+    expect(crunch).toContain("Hand-run only");
+    expect(crunch).toContain("SET is_partner = 0");
+    expect(crunch).toContain("Crunch Fitness - Waukesha");
+    expect(crunch).toContain("Crunch Fitness - Brookfield");
+    expect(crunch).toContain("Crunch Fitness - West Allis");
+    expect(crunch).toContain("Crunch Fitness - Wauwatosa");
+    expect(crunch.toUpperCase()).not.toContain("DROP ");
+
+    expect(migrate).toContain("/^\\d{4}_.+\\.sql$/");
+    expect("hand-run/null-555-venue-phones.sql").not.toMatch(/^\d{4}_.+\.sql$/);
+    expect("hand-run/unset-crunch-gym-partners.sql").not.toMatch(/^\d{4}_.+\.sql$/);
+  });
+});
