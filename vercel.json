{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:web",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/storage/(.*)", "destination": "https://justputzit-backend-production.up.railway.app/manus-storage/$1" },
    { "source": "/manus-storage/(.*)", "destination": "https://justputzit-backend-production.up.railway.app/manus-storage/$1" },
    { "source": "/sitemap.xml", "destination": "https://justputzit-backend-production.up.railway.app/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://justputzit-backend-production.up.railway.app/robots.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
