+export const ORGANIZATION_EVENT_CATEGORIES = ["community", "arts", "music", "food", "market", "sports", "outdoors", "other"] as const;
+
+export type OrganizationEventCategory = (typeof ORGANIZATION_EVENT_CATEGORIES)[number];
+
+const MEMBER_IDENTITY_KEYS = new Set([
+  "userId",
+  "requesterUserId",
+  "submittedByUserId",
+  "createdByUserId",
+  "reviewedByUserId",
+  "email",
+  "profile",
+  "messages",
+  "memberName",
+]);
+
+export function websiteHost(website: string): string | null {
+  const trimmed = website.trim();
+  if (!trimmed) return null;
+  try {
+    const withProtocol = /^https?:\/\//i.test(trimmed) ? trimmed : `https://${trimmed}`;
+    const host = new URL(withProtocol).hostname.toLowerCase().replace(/^www\./, "");
+    return host.includes(".") ? host : null;
+  } catch {
+    return null;
+  }
+}
+
+export function organizationEmailMatchesWebsite(email: string, website?: string | null): boolean {
+  if (!website?.trim()) return true;
+  const host = websiteHost(website);
+  if (!host) return false;
+  const domain = email.split("@")[1]?.toLowerCase().replace(/^www\./, "");
+  if (!domain || !domain.includes(".")) return false;
+  return domain === host || domain.endsWith(`.${host}`) || host.endsWith(`.${domain}`);
+}
+
+export function isFuturePublicEvent(eventDate: Date, now = new Date()): boolean {
+  return Number.isFinite(eventDate.getTime()) && eventDate.getTime() > now.getTime();
+}
+
+export type OrganizerDashboard = {
+  claim: {
+    id: number;
+    organizationName: string;
+    status: string;
+    city: string;
+    state: string | null;
+  };
+  aggregate: {
+    optInMembers: number;
+    inviteLinks: number;
+    approvedEvents: number;
+    publicRsvps: number;
+  };
+  submissions: Array<{
+    id: number;
+    title: string;
+    eventDate: Date;
+    city: string;
+    status: string;
+  }>;
+};
+
+export function toOrganizerDashboard(input: OrganizerDashboard): OrganizerDashboard {
+  return {
+    claim: {
+      id: input.claim.id,
+      organizationName: input.claim.organizationName,
+      status: input.claim.status,
+      city: input.claim.city,
+      state: input.claim.state,
+    },
+    aggregate: {
+      optInMembers: input.aggregate.optInMembers,
+      inviteLinks: input.aggregate.inviteLinks,
+      approvedEvents: input.aggregate.approvedEvents,
+      publicRsvps: input.aggregate.publicRsvps,
+    },
+    submissions: input.submissions.map((submission) => ({
+      id: submission.id,
+      title: submission.title,
+      eventDate: submission.eventDate,
+      city: submission.city,
+      status: submission.status,
+    })),
+  };
+}
+
+export function toPublicInvite(claim: { organizationName: string; city: string; state: string | null }) {
+  return {
+    organizationName: claim.organizationName,
+    city: claim.city,
+    state: claim.state,
+  };
+}
+
+export function containsMemberIdentity(value: unknown): boolean {
+  if (Array.isArray(value)) return value.some(containsMemberIdentity);
+  if (value && typeof value === "object") {
+    return Object.entries(value as Record<string, unknown>).some(
+      ([key, child]) => MEMBER_IDENTITY_KEYS.has(key) || containsMemberIdentity(child),
+    );
+  }
+  return false;
+}
