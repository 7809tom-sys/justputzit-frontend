+-- Additive only. Creates the organization claim tables when a database does not
+-- already have them. Does not DROP, rename, or rewrite existing tables or rows.
+-- Live databases that already contain these tables skip each statement.
+
+CREATE TABLE IF NOT EXISTS `organization_claims` (
+  `id` int AUTO_INCREMENT NOT NULL,
+  `directoryId` varchar(128) NOT NULL,
+  `organizationName` varchar(200) NOT NULL,
+  `address` text,
+  `city` varchar(100) NOT NULL,
+  `state` varchar(50),
+  `officialWebsite` varchar(500),
+  `organizationEmail` varchar(320) NOT NULL,
+  `requesterUserId` int NOT NULL,
+  `status` enum('pending_email_verification','pending_admin_review','verified','rejected') NOT NULL DEFAULT 'pending_email_verification',
+  `emailVerifiedAt` timestamp NULL,
+  `emailVerifyToken` varchar(128),
+  `emailVerifyExpires` timestamp NULL,
+  `reviewedAt` timestamp NULL,
+  `reviewedByUserId` int,
+  `createdAt` timestamp NOT NULL DEFAULT (now()),
+  `updatedAt` timestamp NOT NULL DEFAULT (now()) ON UPDATE CURRENT_TIMESTAMP,
+  CONSTRAINT `organization_claims_id` PRIMARY KEY(`id`)
+);
+
+CREATE TABLE IF NOT EXISTS `organization_memberships` (
+  `id` int AUTO_INCREMENT NOT NULL,
+  `claimId` int NOT NULL,
+  `userId` int NOT NULL,
+  `createdAt` timestamp NOT NULL DEFAULT (now()),
+  CONSTRAINT `organization_memberships_id` PRIMARY KEY(`id`),
+  CONSTRAINT `organization_membership_member_unique` UNIQUE(`claimId`, `userId`)
+);
+
+CREATE TABLE IF NOT EXISTS `organization_invite_links` (
+  `id` int AUTO_INCREMENT NOT NULL,
+  `claimId` int NOT NULL,
+  `inviteCode` varchar(64) NOT NULL,
+  `createdByUserId` int NOT NULL,
+  `createdAt` timestamp NOT NULL DEFAULT (now()),
+  CONSTRAINT `organization_invite_links_id` PRIMARY KEY(`id`),
+  CONSTRAINT `organization_invite_links_inviteCode_unique` UNIQUE(`inviteCode`)
+);
+
+CREATE TABLE IF NOT EXISTS `organization_event_submissions` (
+  `id` int AUTO_INCREMENT NOT NULL,
+  `claimId` int NOT NULL,
+  `submittedByUserId` int NOT NULL,
+  `title` varchar(255) NOT NULL,
+  `description` text,
+  `category` enum('community','arts','music','food','market','sports','outdoors','other') NOT NULL DEFAULT 'community',
+  `eventDate` timestamp NOT NULL,
+  `venueName` varchar(255),
+  `address` text,
+  `city` varchar(100) NOT NULL,
+  `state` varchar(50) NOT NULL DEFAULT 'WI',
+  `isFree` boolean NOT NULL DEFAULT true,
+  `externalUrl` text,
+  `status` enum('pending','approved','rejected') NOT NULL DEFAULT 'pending',
+  `publishedEventId` int,
+  `reviewedAt` timestamp NULL,
+  `reviewedByUserId` int,
+  `createdAt` timestamp NOT NULL DEFAULT (now()),
+  CONSTRAINT `organization_event_submissions_id` PRIMARY KEY(`id`)
+);
