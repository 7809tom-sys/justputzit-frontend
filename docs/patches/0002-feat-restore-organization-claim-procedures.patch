diff --git a/server/routers/organizationClaims.ts b/server/routers/organizationClaims.ts
new file mode 100644
index 0000000..f579b61
--- /dev/null
+++ b/server/routers/organizationClaims.ts
@@ -0,0 +1,255 @@
+import { TRPCError } from "@trpc/server";
+import { z } from "zod";
+import { adminProcedure, protectedProcedure, publicProcedure, router } from "../_core/trpc";
+import {
+  acceptOrganizationInvite,
+  findOpenClaimForDirectory,
+  getClaimById,
+  getClaimByVerificationToken,
+  getEventSubmission,
+  getInviteWithClaim,
+  insertEventSubmission,
+  insertInviteLink,
+  insertOrganizationClaim,
+  listClaimsAwaitingReview,
+  listClaimsForRequester,
+  listEventSubmissionsAwaitingReview,
+  listSubmissionsForOrganizer,
+  markClaimAwaitingReview,
+  markOrganizationEmailVerified,
+  newInviteCode,
+  newOrganizationToken,
+  organizationAggregate,
+  publishOrganizationEvent,
+  rejectOrganizationEvent,
+  reviewOrganizationClaim,
+} from "../organizationClaimsDb";
+import {
+  ORGANIZATION_EVENT_CATEGORIES,
+  isFuturePublicEvent,
+  organizationEmailMatchesWebsite,
+  toOrganizerDashboard,
+  toPublicInvite,
+} from "../organizationClaimsPolicy";
+
+const UNAVAILABLE_INVITE = "This organization invite is unavailable.";
+
+function publicSiteOrigin() {
+  return (process.env.VITE_SITE_URL ?? "https://justputzit.com").trim().replace(/\/$/, "") || "https://justputzit.com";
+}
+
+async function sendOrganizationVerificationEmail(to: string, organizationName: string, token: string): Promise<boolean> {
+  const apiKey = process.env.RESEND_API_KEY;
+  const from = process.env.OUTREACH_FROM_EMAIL;
+  if (!apiKey || !from) return false;
+  const link = `${publicSiteOrigin()}/claim/verify?token=${encodeURIComponent(token)}`;
+  const response = await fetch("https://api.resend.com/emails", {
+    method: "POST",
+    headers: { Authorization: `Bearer ${apiKey}`, "Content-Type": "application/json" },
+    body: JSON.stringify({
+      from,
+      to: [to],
+      subject: `Verify ${organizationName} on Just Putzit`,
+      text: `Confirm the organization email for ${organizationName}.\n\nOpen this link to verify control of the address. Verification does not publish the page or share member information. A Just Putzit administrator still reviews the request.\n\n${link}\n\nIf you did not request this, you can ignore this email.`,
+    }),
+  });
+  return response.ok;
+}
+
+async function requireVerifiedClaimForRequester(claimId: number, userId: number) {
+  const claim = await getClaimById(claimId);
+  if (!claim || claim.requesterUserId !== userId) {
+    throw new TRPCError({ code: "FORBIDDEN", message: "Only the claim requester can open this organization workspace." });
+  }
+  if (claim.status !== "verified") {
+    throw new TRPCError({ code: "PRECONDITION_FAILED", message: "This page opens after an administrator verifies the claim." });
+  }
+  return claim;
+}
+
+const eventInput = z.object({
+  claimId: z.number().int().positive(),
+  title: z.string().trim().min(3).max(255),
+  description: z.string().trim().max(4_000).optional(),
+  category: z.enum(ORGANIZATION_EVENT_CATEGORIES).default("community"),
+  eventDate: z.string().datetime(),
+  venueName: z.string().trim().max(255).optional(),
+  address: z.string().trim().max(500).optional(),
+  city: z.string().trim().min(1).max(100),
+  state: z.string().trim().min(2).max(50).default("WI"),
+  isFree: z.boolean().default(true),
+  externalUrl: z.string().trim().url().max(1_000).optional(),
+});
+
+export const organizationClaimsRouter = router({
+  request: protectedProcedure
+    .input(z.object({
+      directoryId: z.string().trim().min(1).max(128),
+      organizationName: z.string().trim().min(2).max(200),
+      address: z.string().trim().max(500).optional(),
+      city: z.string().trim().min(1).max(100),
+      state: z.string().trim().max(50).optional(),
+      officialWebsite: z.string().trim().max(500).optional(),
+      organizationEmail: z.string().trim().email().max(320),
+    }))
+    .mutation(async ({ ctx, input }) => {
+      if (!organizationEmailMatchesWebsite(input.organizationEmail, input.officialWebsite)) {
+        throw new TRPCError({ code: "BAD_REQUEST", message: "Use an email address on the organization's official domain." });
+      }
+      const existing = await findOpenClaimForDirectory(input.directoryId);
+      if (existing) {
+        throw new TRPCError({
+          code: "CONFLICT",
+          message: existing.status === "verified"
+            ? "This organization page has already been verified."
+            : "A claim for this organization is already being reviewed.",
+        });
+      }
+      const token = newOrganizationToken();
+      const claim = await insertOrganizationClaim({
+        directoryId: input.directoryId,
+        organizationName: input.organizationName,
+        address: input.address,
+        city: input.city,
+        state: input.state,
+        officialWebsite: input.officialWebsite,
+        organizationEmail: input.organizationEmail,
+        requesterUserId: ctx.user.id,
+        status: "pending_email_verification",
+        emailVerifyToken: token,
+        emailVerifyExpires: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000),
+      });
+      const verificationEmailSent = await sendOrganizationVerificationEmail(input.organizationEmail, input.organizationName, token);
+      if (!verificationEmailSent) await markClaimAwaitingReview(claim.id);
+      return {
+        id: claim.id,
+        status: verificationEmailSent ? "pending_email_verification" as const : "pending_admin_review" as const,
+        verificationEmailSent,
+      };
+    }),
+
+  verifyEmail: publicProcedure
+    .input(z.object({ token: z.string().trim().min(16).max(128) }))
+    .mutation(async ({ input }) => {
+      const claim = await getClaimByVerificationToken(input.token);
+      const expiresAt = claim?.emailVerifyExpires ? new Date(claim.emailVerifyExpires).getTime() : null;
+      if (!claim || claim.status === "rejected" || (expiresAt !== null && expiresAt < Date.now())) {
+        throw new TRPCError({ code: "NOT_FOUND", message: "This verification link is invalid or has expired." });
+      }
+      if (claim.status === "pending_email_verification") await markOrganizationEmailVerified(claim.id);
+      return { verified: true };
+    }),
+
+  mine: protectedProcedure.query(async ({ ctx }) => listClaimsForRequester(ctx.user.id)),
+
+  dashboard: protectedProcedure
+    .input(z.object({ claimId: z.number().int().positive() }))
+    .query(async ({ ctx, input }) => {
+      const claim = await requireVerifiedClaimForRequester(input.claimId, ctx.user.id);
+      const [aggregate, submissions] = await Promise.all([
+        organizationAggregate(claim.id),
+        listSubmissionsForOrganizer(claim.id),
+      ]);
+      return toOrganizerDashboard({
+        claim: {
+          id: claim.id,
+          organizationName: claim.organizationName,
+          status: claim.status,
+          city: claim.city,
+          state: claim.state,
+        },
+        aggregate,
+        submissions,
+      });
+    }),
+
+  createInviteLink: protectedProcedure
+    .input(z.object({ claimId: z.number().int().positive() }))
+    .mutation(async ({ ctx, input }) => {
+      const claim = await requireVerifiedClaimForRequester(input.claimId, ctx.user.id);
+      const inviteCode = newInviteCode();
+      await insertInviteLink(claim.id, ctx.user.id, inviteCode);
+      return { inviteCode, inviteUrl: `${publicSiteOrigin()}/join/organization/${inviteCode}` };
+    }),
+
+  getInvite: publicProcedure
+    .input(z.object({ inviteCode: z.string().trim().min(8).max(64) }))
+    .query(async ({ input }) => {
+      const invite = await getInviteWithClaim(input.inviteCode);
+      if (!invite || invite.status !== "verified") throw new TRPCError({ code: "NOT_FOUND", message: UNAVAILABLE_INVITE });
+      return toPublicInvite(invite);
+    }),
+
+  acceptInvite: protectedProcedure
+    .input(z.object({
+      inviteCode: z.string().trim().min(8).max(64),
+      confirmed: z.literal(true),
+    }))
+    .mutation(async ({ ctx, input }) => {
+      const invite = await getInviteWithClaim(input.inviteCode);
+      if (!invite || invite.status !== "verified") throw new TRPCError({ code: "NOT_FOUND", message: UNAVAILABLE_INVITE });
+      await acceptOrganizationInvite(invite.claimId, ctx.user.id);
+      return { organizationName: invite.organizationName };
+    }),
+
+  submitPublicEvent: protectedProcedure
+    .input(eventInput)
+    .mutation(async ({ ctx, input }) => {
+      await requireVerifiedClaimForRequester(input.claimId, ctx.user.id);
+      const eventDate = new Date(input.eventDate);
+      if (!isFuturePublicEvent(eventDate)) {
+        throw new TRPCError({ code: "BAD_REQUEST", message: "Public events must be scheduled in the future." });
+      }
+      const submission = await insertEventSubmission({
+        claimId: input.claimId,
+        submittedByUserId: ctx.user.id,
+        title: input.title,
+        description: input.description,
+        category: input.category,
+        eventDate,
+        venueName: input.venueName,
+        address: input.address,
+        city: input.city,
+        state: input.state,
+        isFree: input.isFree,
+        externalUrl: input.externalUrl,
+      });
+      return { id: submission.id, status: "pending" as const };
+    }),
+
+  reviewQueue: adminProcedure.query(async () => ({
+    claims: await listClaimsAwaitingReview(),
+    submissions: await listEventSubmissionsAwaitingReview(),
+  })),
+
+  reviewClaim: adminProcedure
+    .input(z.object({ claimId: z.number().int().positive(), approved: z.boolean() }))
+    .mutation(async ({ ctx, input }) => {
+      const claim = await getClaimById(input.claimId);
+      if (!claim) throw new TRPCError({ code: "NOT_FOUND", message: "Organization claim not found." });
+      if (claim.status === "rejected" || claim.status === "verified") {
+        throw new TRPCError({ code: "PRECONDITION_FAILED", message: "This organization claim has already been reviewed." });
+      }
+      await reviewOrganizationClaim(claim.id, input.approved, ctx.user.id);
+      return { status: input.approved ? "verified" as const : "rejected" as const };
+    }),
+
+  reviewEvent: adminProcedure
+    .input(z.object({ submissionId: z.number().int().positive(), approved: z.boolean() }))
+    .mutation(async ({ ctx, input }) => {
+      const submission = await getEventSubmission(input.submissionId);
+      if (!submission) throw new TRPCError({ code: "NOT_FOUND", message: "Event submission not found." });
+      if (submission.status !== "pending") {
+        throw new TRPCError({ code: "PRECONDITION_FAILED", message: "This event submission has already been reviewed." });
+      }
+      if (!input.approved) {
+        await rejectOrganizationEvent(submission.id, ctx.user.id);
+        return { publishedEventId: null };
+      }
+      if (!isFuturePublicEvent(submission.eventDate)) {
+        throw new TRPCError({ code: "BAD_REQUEST", message: "Only a future public event can be published." });
+      }
+      const publishedEventId = await publishOrganizationEvent(submission, ctx.user.id);
+      return { publishedEventId };
+    }),
+});
