+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { describe, expect, it } from "vitest";
+import {
+  containsMemberIdentity,
+  isFuturePublicEvent,
+  organizationEmailMatchesWebsite,
+  toOrganizerDashboard,
+  toPublicInvite,
+} from "./organizationClaimsPolicy";
+
+describe("organization claims", () => {
+  it("was rebuilt because the source was not in the exported repositories", () => {
+    const router = readFileSync(resolve(__dirname, "routers/organizationClaims.ts"), "utf8");
+    const schema = readFileSync(resolve(__dirname, "../drizzle/schema.ts"), "utf8");
+    const migration = readFileSync(resolve(__dirname, "../drizzle/0064_organization_claims.sql"), "utf8");
+
+    for (const procedure of [
+      "request: protectedProcedure",
+      "verifyEmail: publicProcedure",
+      "mine: protectedProcedure",
+      "dashboard: protectedProcedure",
+      "createInviteLink: protectedProcedure",
+      "getInvite: publicProcedure",
+      "acceptInvite: protectedProcedure",
+      "submitPublicEvent: protectedProcedure",
+      "reviewQueue: adminProcedure",
+      "reviewClaim: adminProcedure",
+      "reviewEvent: adminProcedure",
+    ]) {
+      expect(router).toContain(procedure);
+    }
+    expect(router).toContain("confirmed: z.literal(true)");
+    expect(router).toContain("Only the claim requester can open this organization workspace.");
+
+    for (const table of [
+      'mysqlTable("organization_claims"',
+      'mysqlTable("organization_memberships"',
+      'mysqlTable("organization_invite_links"',
+      'mysqlTable("organization_event_submissions"',
+    ]) {
+      expect(schema).toContain(table);
+    }
+    expect(migration).toContain("CREATE TABLE IF NOT EXISTS `organization_claims`");
+    expect(migration).toContain("CREATE TABLE IF NOT EXISTS `organization_memberships`");
+    expect(migration).toContain("CREATE TABLE IF NOT EXISTS `organization_invite_links`");
+    expect(migration).toContain("CREATE TABLE IF NOT EXISTS `organization_event_submissions`");
+    expect(migration.toUpperCase()).not.toContain("DROP ");
+    expect(migration.toUpperCase()).not.toContain("DELETE ");
+  });
+
+  it("requires an official-domain email when a website is supplied", () => {
+    expect(organizationEmailMatchesWebsite("office@gracechurch.org", "https://www.gracechurch.org")).toBe(true);
+    expect(organizationEmailMatchesWebsite("office@mail.gracechurch.org", "gracechurch.org")).toBe(true);
+    expect(organizationEmailMatchesWebsite("person@gmail.com", "https://gracechurch.org")).toBe(false);
+    expect(organizationEmailMatchesWebsite("office@gracechurch.org")).toBe(true);
+  });
+
+  it("keeps organizer views to totals and the organizer's own submissions", () => {
+    const now = new Date("2026-11-01T15:00:00.000Z");
+    expect(isFuturePublicEvent(now, new Date("2026-10-29T00:00:00.000Z"))).toBe(true);
+    expect(isFuturePublicEvent(new Date("2026-10-01T00:00:00.000Z"), now)).toBe(false);
+
+    const dashboard = toOrganizerDashboard({
+      claim: { id: 4, organizationName: "Grace Church", status: "verified", city: "Waukesha", state: "WI" },
+      aggregate: { optInMembers: 12, inviteLinks: 2, approvedEvents: 1, publicRsvps: 7 },
+      submissions: [{ id: 9, title: "Community meal", eventDate: now, city: "Waukesha", status: "pending" }],
+    });
+    expect(dashboard.aggregate).toEqual({ optInMembers: 12, inviteLinks: 2, approvedEvents: 1, publicRsvps: 7 });
+    expect(containsMemberIdentity(dashboard)).toBe(false);
+    expect(containsMemberIdentity(toPublicInvite({ organizationName: "Grace Church", city: "Waukesha", state: "WI" }))).toBe(false);
+    expect(containsMemberIdentity({ userId: 3, organizationName: "Grace Church" })).toBe(true);
+  });
+});
