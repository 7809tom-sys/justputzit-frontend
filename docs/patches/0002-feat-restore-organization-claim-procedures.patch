+import { and, desc, eq, inArray, sql } from "drizzle-orm";
+import { randomBytes } from "crypto";
+import {
+  communityEvents,
+  organizationClaims,
+  organizationEventSubmissions,
+  organizationInviteLinks,
+  organizationMemberships,
+  type InsertOrganizationClaim,
+  type OrganizationClaim,
+  type OrganizationEventSubmission,
+} from "../drizzle/schema";
+import { getDb } from "./db";
+import type { OrganizationEventCategory } from "./organizationClaimsPolicy";
+
+async function db() {
+  const connection = await getDb();
+  if (!connection) throw new Error("DB unavailable");
+  return connection;
+}
+
+function countValue(value: unknown): number {
+  const parsed = Number(value ?? 0);
+  return Number.isFinite(parsed) ? parsed : 0;
+}
+
+export function newOrganizationToken(): string {
+  return randomBytes(24).toString("hex");
+}
+
+export function newInviteCode(): string {
+  return randomBytes(16).toString("hex");
+}
+
+export async function findOpenClaimForDirectory(directoryId: string): Promise<OrganizationClaim | null> {
+  const connection = await db();
+  const [row] = await connection
+    .select()
+    .from(organizationClaims)
+    .where(and(
+      eq(organizationClaims.directoryId, directoryId),
+      inArray(organizationClaims.status, ["pending_email_verification", "pending_admin_review", "verified"]),
+    ))
+    .limit(1);
+  return row ?? null;
+}
+
+export async function insertOrganizationClaim(input: InsertOrganizationClaim): Promise<OrganizationClaim> {
+  const connection = await db();
+  const [result] = await connection.insert(organizationClaims).values(input);
+  const [row] = await connection.select().from(organizationClaims).where(eq(organizationClaims.id, Number(result.insertId))).limit(1);
+  if (!row) throw new Error("Organization claim was not saved");
+  return row;
+}
+
+export async function listClaimsForRequester(userId: number) {
+  const connection = await db();
+  return connection
+    .select({
+      id: organizationClaims.id,
+      organizationName: organizationClaims.organizationName,
+      status: organizationClaims.status,
+      city: organizationClaims.city,
+      state: organizationClaims.state,
+    })
+    .from(organizationClaims)
+    .where(eq(organizationClaims.requesterUserId, userId))
+    .orderBy(desc(organizationClaims.createdAt));
+}
+
+export async function getClaimById(claimId: number): Promise<OrganizationClaim | null> {
+  const connection = await db();
+  const [row] = await connection.select().from(organizationClaims).where(eq(organizationClaims.id, claimId)).limit(1);
+  return row ?? null;
+}
+
+export async function getClaimByVerificationToken(token: string): Promise<OrganizationClaim | null> {
+  const connection = await db();
+  const [row] = await connection.select().from(organizationClaims).where(eq(organizationClaims.emailVerifyToken, token)).limit(1);
+  return row ?? null;
+}
+
+export async function markOrganizationEmailVerified(claimId: number) {
+  const connection = await db();
+  await connection.update(organizationClaims).set({
+    status: "pending_admin_review",
+    emailVerifiedAt: new Date(),
+    emailVerifyToken: null,
+    emailVerifyExpires: null,
+  }).where(eq(organizationClaims.id, claimId));
+}
+
+export async function markClaimAwaitingReview(claimId: number) {
+  const connection = await db();
+  await connection.update(organizationClaims).set({ status: "pending_admin_review" }).where(eq(organizationClaims.id, claimId));
+}
+
+export async function reviewOrganizationClaim(claimId: number, approved: boolean, reviewerUserId: number) {
+  const connection = await db();
+  await connection.update(organizationClaims).set({
+    status: approved ? "verified" : "rejected",
+    reviewedAt: new Date(),
+    reviewedByUserId: reviewerUserId,
+    emailVerifyToken: null,
+  }).where(eq(organizationClaims.id, claimId));
+}
+
+export async function organizationAggregate(claimId: number) {
+  const connection = await db();
+  const [members] = await connection
+    .select({ count: sql<number>`count(*)` })
+    .from(organizationMemberships)
+    .where(eq(organizationMemberships.claimId, claimId));
+  const [links] = await connection
+    .select({ count: sql<number>`count(*)` })
+    .from(organizationInviteLinks)
+    .where(eq(organizationInviteLinks.claimId, claimId));
+  const [events] = await connection
+    .select({
+      count: sql<number>`count(*)`,
+      rsvps: sql<number>`coalesce(sum(${communityEvents.rsvpCount}), 0)`,
+    })
+    .from(organizationEventSubmissions)
+    .innerJoin(communityEvents, eq(organizationEventSubmissions.publishedEventId, communityEvents.id))
+    .where(and(
+      eq(organizationEventSubmissions.claimId, claimId),
+      eq(organizationEventSubmissions.status, "approved"),
+    ));
+  return {
+    optInMembers: countValue(members?.count),
+    inviteLinks: countValue(links?.count),
+    approvedEvents: countValue(events?.count),
+    publicRsvps: countValue(events?.rsvps),
+  };
+}
+
+export async function listSubmissionsForOrganizer(claimId: number) {
+  const connection = await db();
+  return connection
+    .select({
+      id: organizationEventSubmissions.id,
+      title: organizationEventSubmissions.title,
+      eventDate: organizationEventSubmissions.eventDate,
+      city: organizationEventSubmissions.city,
+      status: organizationEventSubmissions.status,
+    })
+    .from(organizationEventSubmissions)
+    .where(eq(organizationEventSubmissions.claimId, claimId))
+    .orderBy(desc(organizationEventSubmissions.createdAt));
+}
+
+export async function insertInviteLink(claimId: number, createdByUserId: number, inviteCode: string) {
+  const connection = await db();
+  await connection.insert(organizationInviteLinks).values({ claimId, createdByUserId, inviteCode });
+}
+
+export async function getInviteWithClaim(inviteCode: string) {
+  const connection = await db();
+  const [row] = await connection
+    .select({
+      inviteCode: organizationInviteLinks.inviteCode,
+      claimId: organizationClaims.id,
+      organizationName: organizationClaims.organizationName,
+      city: organizationClaims.city,
+      state: organizationClaims.state,
+      status: organizationClaims.status,
+    })
+    .from(organizationInviteLinks)
+    .innerJoin(organizationClaims, eq(organizationInviteLinks.claimId, organizationClaims.id))
+    .where(eq(organizationInviteLinks.inviteCode, inviteCode))
+    .limit(1);
+  return row ?? null;
+}
+
+export async function acceptOrganizationInvite(claimId: number, userId: number) {
+  const connection = await db();
+  const [existing] = await connection
+    .select({ id: organizationMemberships.id })
+    .from(organizationMemberships)
+    .where(and(eq(organizationMemberships.claimId, claimId), eq(organizationMemberships.userId, userId)))
+    .limit(1);
+  if (existing) return;
+  await connection.insert(organizationMemberships).values({ claimId, userId });
+}
+
+export async function insertEventSubmission(input: {
+  claimId: number;
+  submittedByUserId: number;
+  title: string;
+  description?: string;
+  category: OrganizationEventCategory;
+  eventDate: Date;
+  venueName?: string;
+  address?: string;
+  city: string;
+  state: string;
+  isFree: boolean;
+  externalUrl?: string;
+}): Promise<OrganizationEventSubmission> {
+  const connection = await db();
+  const [result] = await connection.insert(organizationEventSubmissions).values(input);
+  const [row] = await connection.select().from(organizationEventSubmissions).where(eq(organizationEventSubmissions.id, Number(result.insertId))).limit(1);
+  if (!row) throw new Error("Event submission was not saved");
+  return row;
+}
+
+export async function listClaimsAwaitingReview() {
+  const connection = await db();
+  return connection
+    .select({
+      id: organizationClaims.id,
+      organizationName: organizationClaims.organizationName,
+      address: organizationClaims.address,
+      city: organizationClaims.city,
+      state: organizationClaims.state,
+      organizationEmail: organizationClaims.organizationEmail,
+      officialWebsite: organizationClaims.officialWebsite,
+      emailVerifiedAt: organizationClaims.emailVerifiedAt,
+      status: organizationClaims.status,
+    })
+    .from(organizationClaims)
+    .where(inArray(organizationClaims.status, ["pending_email_verification", "pending_admin_review"]))
+    .orderBy(desc(organizationClaims.createdAt));
+}
+
+export async function listEventSubmissionsAwaitingReview() {
+  const connection = await db();
+  return connection
+    .select({
+      id: organizationEventSubmissions.id,
+      claimId: organizationEventSubmissions.claimId,
+      title: organizationEventSubmissions.title,
+      description: organizationEventSubmissions.description,
+      eventDate: organizationEventSubmissions.eventDate,
+      venueName: organizationEventSubmissions.venueName,
+      city: organizationEventSubmissions.city,
+      state: organizationEventSubmissions.state,
+      externalUrl: organizationEventSubmissions.externalUrl,
+      organizationName: organizationClaims.organizationName,
+    })
+    .from(organizationEventSubmissions)
+    .innerJoin(organizationClaims, eq(organizationEventSubmissions.claimId, organizationClaims.id))
+    .where(eq(organizationEventSubmissions.status, "pending"))
+    .orderBy(desc(organizationEventSubmissions.createdAt));
+}
+
+export async function getEventSubmission(submissionId: number): Promise<OrganizationEventSubmission | null> {
+  const connection = await db();
+  const [row] = await connection.select().from(organizationEventSubmissions).where(eq(organizationEventSubmissions.id, submissionId)).limit(1);
+  return row ?? null;
+}
+
+export async function publishOrganizationEvent(submission: OrganizationEventSubmission, reviewerUserId: number): Promise<number> {
+  const connection = await db();
+  const [result] = await connection.insert(communityEvents).values({
+    title: submission.title,
+    description: submission.description,
+    category: submission.category,
+    eventDate: submission.eventDate,
+    venueName: submission.venueName,
+    address: submission.address,
+    city: submission.city,
+    state: submission.state,
+    isFree: submission.isFree,
+    priceCents: 0,
+    externalUrl: submission.externalUrl,
+    source: "community",
+    postedByUserId: submission.submittedByUserId,
+    isActive: true,
+  });
+  const publishedEventId = Number(result.insertId);
+  await connection.update(organizationEventSubmissions).set({
+    status: "approved",
+    publishedEventId,
+    reviewedAt: new Date(),
+    reviewedByUserId: reviewerUserId,
+  }).where(eq(organizationEventSubmissions.id, submission.id));
+  return publishedEventId;
+}
+
+export async function rejectOrganizationEvent(submissionId: number, reviewerUserId: number) {
+  const connection = await db();
+  await connection.update(organizationEventSubmissions).set({
+    status: "rejected",
+    reviewedAt: new Date(),
+    reviewedByUserId: reviewerUserId,
+  }).where(eq(organizationEventSubmissions.id, submissionId));
+}
