{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:web",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/manus-storage/:path*", "destination": "https://REPLACE-WITH-RAILWAY-DOMAIN/manus-storage/:path*" },
    { "source": "/sitemap.xml", "destination": "https://REPLACE-WITH-RAILWAY-DOMAIN/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://REPLACE-WITH-RAILWAY-DOMAIN/robots.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
