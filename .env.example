# ===== FRONTEND (Vite, public values only; set these in Vercel) =====
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MAPTILER_KEY=
VITE_SITE_URL=http://localhost:5173
# Umami analytics. Leave both blank to disable; events become no-ops.
# Endpoint is the Umami host (e.g. https://analytics.example.com), website id from its dashboard.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
